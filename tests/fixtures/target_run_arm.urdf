<?xml version="1.0"?>
<!-- A made-up 3-joint arm for the target-vs-run Rerun tests (tests/target_run_fixture.py holds its closed-form
     kinematics, the tests' oracle): a pan about z, a shoulder and an elbow about y, a flange (tool0) 0.2 m out. -->
<robot name="target_run_arm">
  <link name="base"><visual><geometry><cylinder radius="0.05" length="0.1"/></geometry></visual></link>
  <link name="l1"><visual><origin xyz="0 0 0.15"/><geometry><box size="0.06 0.06 0.3"/></geometry></visual></link>
  <link name="l2"><visual><origin xyz="0 0 0.125"/><geometry><box size="0.05 0.05 0.25"/></geometry></visual></link>
  <link name="l3"><visual><origin xyz="0 0 0.1"/><geometry><box size="0.04 0.04 0.2"/></geometry></visual></link>
  <link name="tool0"/>
  <joint name="pan" type="revolute"><parent link="base"/><child link="l1"/><origin xyz="0 0 0.1"/><axis xyz="0 0 1"/>
    <limit lower="-3.1" upper="3.1" effort="5" velocity="3"/></joint>
  <joint name="shoulder" type="revolute"><parent link="l1"/><child link="l2"/><origin xyz="0 0 0.3"/><axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="5" velocity="3"/></joint>
  <joint name="elbow" type="revolute"><parent link="l2"/><child link="l3"/><origin xyz="0 0 0.25"/><axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="5" velocity="4"/></joint>
  <joint name="flange" type="fixed"><parent link="l3"/><child link="tool0"/><origin xyz="0 0 0.2"/></joint>
</robot>
