   "layout": {
    "columns": 12,
    "rowHeight": 88,
    "panels": [
     {
      "view": "T3 answer",
      "w": 12,
      "h": 2,
      "title": "The answer · per target: median tool RMS over each config's runs; a tie is within 5 %"
