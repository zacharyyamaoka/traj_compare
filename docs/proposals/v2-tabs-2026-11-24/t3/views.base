     }
    ]
   }
  }
 ],
 "views": [
  {
   "type": "chart",
   "name": "League",
   "filters": "speed == 1",
   "chart": {
    "transform": [
     {
      "filter": "isValid(datum.tcp) && datum.tcp > 0"
     },
     {
      "aggregate": [
       {
        "op": "median",
        "field": "tcp",
        "as": "tcp"
       }
      ],
      "groupby": [
       "config",
       "target_key"
      ]
     },
     {
      "aggregate": [
       {
        "op": "median",
        "field": "tcp",
        "as": "tcp"
       },
       {
        "op": "count",
        "as": "n"
       }
      ],
      "groupby": [
       "config"
      ]
     },
     {
      "joinaggregate": [
       {
        "op": "min",
        "field": "tcp",
        "as": "best"
       }
      ]
     },
     {
      "calculate": "datum.tcp / datum.best",
      "as": "ratio"
     },
     {
      "window": [
       {
        "op": "rank",
        "as": "rank"
       }
      ],
      "sort": [
       {
        "field": "tcp",
        "order": "ascending"
       }
      ]
     },
     {
      "calculate": "'#' + (datum.rank < 10 ? '0' : '') + datum.rank + '  ' + datum.config + '   ' + format(datum.tcp, '.3~g') + ' mm   ×' + (datum.ratio < 100 ? format(datum.ratio, '.3~g') : format(datum.ratio, ',.0f')) + '   n=' + datum.n",
      "as": "label"
     }
    ],
    "mark": {
     "type": "point",
     "filled": true,
     "size": 120,
     "opacity": 1,
     "color": "#57606a"
    },
    "encoding": {
     "y": {
      "field": "label",
      "type": "nominal",
      "sort": {
       "field": "tcp"
      },
      "title": null,
      "axis": {
       "labelLimit": 460,
       "labelFontSize": 11,
       "labelOverlap": false
      }
     },
     "x": {
      "field": "tcp",
      "type": "quantitative",
      "scale": {
       "type": "log"
      },
      "title": "tool tracking RMS at 1.0 ×, mm (median over targets of median over its runs); n = targets"
     }
    }
   },
   "hover": {
    "title": "config",
    "fields": [
     "tcp",
     "target_key"
    ]
   }
  },
  {
   "type": "chart",
   "name": "League by model type",
   "filters": "speed == 1",
   "chart": {
    "transform": [
     {
      "filter": "isValid(datum.tcp) && datum.tcp > 0"
     },
     {
      "aggregate": [
       {
        "op": "median",
        "field": "tcp",
        "as": "tcp"
       }
      ],
      "groupby": [
       "model_type",
       "target_key"
      ]
     },
     {
      "aggregate": [
       {
        "op": "median",
        "field": "tcp",
        "as": "tcp"
       },
       {
        "op": "count",
        "as": "n"
       }
      ],
      "groupby": [
       "model_type"
      ]
     },
     {
      "joinaggregate": [
       {
        "op": "min",
        "field": "tcp",
        "as": "best"
       }
      ]
     },
     {
      "calculate": "datum.tcp / datum.best",
      "as": "ratio"
     },
     {
      "window": [
       {
        "op": "rank",
        "as": "rank"
       }
      ],
      "sort": [
       {
        "field": "tcp",
        "order": "ascending"
       }
      ]
     },
     {
      "calculate": "'#' + (datum.rank < 10 ? '0' : '') + datum.rank + '  ' + datum.model_type + '   ' + format(datum.tcp, '.3~g') + ' mm   ×' + (datum.ratio < 100 ? format(datum.ratio, '.3~g') : format(datum.ratio, ',.0f')) + '   n=' + datum.n",
      "as": "label"
     }
    ],
    "mark": {
     "type": "point",
     "filled": true,
     "size": 120,
     "opacity": 1,
     "color": "#57606a"
    },
    "encoding": {
     "y": {
      "field": "label",
      "type": "nominal",
      "sort": {
       "field": "tcp"
      },
      "title": null,
      "axis": {
       "labelLimit": 460,
       "labelFontSize": 11,
       "labelOverlap": false
      }
     },
     "x": {
      "field": "tcp",
      "type": "quantitative",
      "scale": {
       "type": "log"
      },
      "title": "tool tracking RMS at 1.0 ×, mm (median over targets of median over its runs); n = targets"
     }
    }
   },
   "hover": {
    "title": "model_type",
    "fields": [
     "tcp",
     "target_key"
    ]
   }
  },
  {
   "type": "chart",
   "name": "Speed sweeps",
   "chart": {
    "transform": [
     {
      "filter": "isValid(datum.tcp) && datum.tcp > 0"
     },
     {
      "aggregate": [
       {
        "op": "median",
        "field": "tcp",
        "as": "tcp"
       }
      ],
      "groupby": [
       "model_type",
       "dataset",
       "speed",
       "target_key"
      ]
     },
     {
      "aggregate": [
       {
        "op": "median",
        "field": "tcp",
        "as": "tcp"
       }
      ],
      "groupby": [
       "model_type",
       "dataset",
       "speed"
      ]
     }
    ],
    "mark": {
     "type": "line",
     "point": true
    },
    "encoding": {
     "x": {
      "field": "speed",
      "type": "quantitative",
      "title": "speed (× fastest)",
      "scale": {
       "domain": [
        0,
        1
       ]
      }
     },
     "y": {
      "field": "tcp",
      "type": "quantitative",
      "scale": {
       "type": "log"
      },
      "title": "tool RMS, mm",
      "axis": {
       "grid": false,
       "tickCount": 4
      }
     },
     "color": {
      "field": "dataset",
      "type": "nominal",
      "title": "Dataset"
     },
     "facet": {
      "field": "model_type",
      "type": "nominal",
      "columns": 3,
      "title": null
     }
    }
   },
   "hover": {
    "title": "dataset",
    "fields": [
     "tcp",
     "target_key",
     "model_type"
    ]
   }
  },
  {
   "type": "pivot",
   "name": "Model type × deployment",
   "order": [
    "model_type"
   ],
   "splitBy": [
    "deployment"
   ],
   "value": {
    "property": "tcp",
    "summary": "Median",
    "display": "dist"
   }
  },
  {
   "type": "table",
   "name": "Targets",
   "from": "targets",
   "order": [
    "target",
    "deployment",
    "dataset",
    "split",
    "speed",
    "kind",
    "runs_all",
    "configs_all",
    "target_view"
   ],
   "sort": [
    {
     "property": "deployment",
     "direction": "ASC"
    },
    {
     "property": "target",
     "direction": "ASC"
    }
   ],
   "display": {
    "dataset": "badge",
    "target_view": "link"
   }
  },
  {
   "type": "table",
   "name": "Runs",
   "order": [
    "target",
    "config",
    "series",
    "repeat",
    "deployment",
    "dataset",
    "split",
    "speed",
    "model_type",
    "tcp",
    "worst",
    "worst_joint",
    "fb",
    "energy",
    "target_view",
    "run_report"
   ],
   "sort": [
    {
     "property": "tcp",
     "direction": "DESC"
    }
   ],
   "display": {
    "dataset": "badge",
    "tcp": "bar",
    "target_view": "link",
    "run_report": "link"
   }
  },
  {
   "type": "chart",
   "name": "T3 answer",
   "from": "h2h",
   "chart": {
    "layer": [
     {
      "transform": [
       {
        "calculate": "split(datum.target, ' · ')[0] + ' at ' + datum.speed + ' ×'",
        "as": "tname"
       },
       {
        "aggregate": [
         {
          "op": "count",
          "as": "n"
         },
         {
          "op": "sum",
          "field": "b_better",
          "as": "bw"
         },
         {
          "op": "sum",
          "field": "a_better",
          "as": "aw"
         },
         {
          "op": "sum",
          "field": "tie",
          "as": "t"
         },
         {
          "op": "median",
          "field": "ratio",
          "as": "med"
         }
        ],
        "groupby": [
         "config_a",
         "config_b"
        ]
       },
       {
        "calculate": "'B ' + datum.config_b + ' beats A ' + datum.config_a + ' on ' + format(datum.bw, ',') + ' of ' + format(datum.n, ',') + ' targets they both ran, loses on ' + format(datum.aw, ',') + ', ties ' + format(datum.t, ',') + '; median B ÷ A = ' + format(datum.med, '.3~f') + ' (' + (datum.med <= 1 ? 'B ' + format(1 - datum.med, '.0%') + ' better' : 'B ' + format(datum.med - 1, '.0%') + ' worse') + ').'",
        "as": "answer"
       }
      ],
      "mark": {
       "type": "text",
       "align": "left",
       "baseline": "middle",
       "fontSize": 15,
       "fontWeight": 600,
       "x": 4,
       "limit": 1300
      },
      "encoding": {
       "text": {
        "field": "answer",
        "type": "nominal"
       },
       "y": {
        "field": "config_a",
        "type": "nominal",
        "axis": null,
        "title": null,
        "scale": {
         "range": [
          0,
          22
         ],
         "paddingInner": 0,
         "paddingOuter": 0.5
        }
       }
      }
     },
     {
      "transform": [
       {
        "calculate": "split(datum.target, ' · ')[0] + ' at ' + datum.speed + ' ×'",
        "as": "tname"
       },
       {
        "aggregate": [
         {
          "op": "argmax",
          "field": "change",
          "as": "up"
         },
         {
          "op": "argmin",
          "field": "change",
          "as": "down"
         }
        ],
        "groupby": [
         "config_a",
         "config_b"
        ]
       },
       {
        "calculate": "'Biggest regression: ' + datum.up.tname + ' (B ' + format(datum.up.change / 100, '+.0%') + ')' + '   ·   biggest gain: ' + datum.down.tname + ' (B ' + format(datum.down.change / 100, '+.0%') + ')'",
        "as": "answer"
       }
      ],
      "mark": {
       "type": "text",
       "align": "left",
       "baseline": "middle",
       "fontSize": 12.5,
       "fontWeight": 400,
       "x": 4,
       "limit": 1300
      },
      "encoding": {
       "text": {
        "field": "answer",
        "type": "nominal"
       },
       "y": {
        "field": "config_a",
        "type": "nominal",
        "axis": null,
        "title": null,
        "scale": {
         "range": [
          26,
          74
         ],
         "paddingInner": 0,
         "paddingOuter": 0.5
        }
       }
      }
     }
    ],
    "resolve": {
     "scale": {
      "y": "independent"
     }
    }
   },
   "hover": {
    "title": "target",
    "fields": [
     "ratio",
     "change",
     "verdict",
     "config_a",
     "config_b",
     "b_better",
     "a_better",
     "tie"
    ]
   }
  },
  {
   "type": "chart",
   "name": "T3 by dataset",
   "from": "h2h",
   "chart": {
    "mark": {
     "type": "bar"
    },
    "encoding": {
     "y": {
      "field": "dataset",
      "type": "nominal",
      "title": null,
      "axis": {
       "labelLimit": 360
      }
     },
     "x": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "targets",
      "stack": "zero"
     },
     "color": {
      "field": "verdict",
      "type": "nominal",
      "title": "Verdict",
      "scale": {
       "domain": [
        "B better",
        "tie (within 5 %)",
        "A better"
       ],
       "range": [
        "#1f6feb",
        "#8c959f",
        "#8250df"
       ]
      }
     },
     "order": {
      "field": "verdict",
      "sort": "descending"
     }
    }
   },
   "hover": {
    "title": "dataset",
    "fields": [
     "verdict",
