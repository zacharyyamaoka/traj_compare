  {
   "name": "Which config wins head to head?",
   "datasets": {
    "h2h": {
     "facets": [
      {
       "property": "config_a",
       "as": "select",
       "label": "A · current",
       "dropdown": true
      },
      {
       "property": "config_b",
       "as": "select",
       "label": "B · candidate",
       "dropdown": true
      }
     ],
     "filters": {
      "and": [
       "config_a == \"ctc_tuned\"",
       "config_b == \"ctc_tuned_v2\""
      ]
     }
