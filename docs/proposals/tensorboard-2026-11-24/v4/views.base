 "views": [
  {
   "type": "chart",
   "name": "League",
   "filters": "speed == 1",
   "chart": {
    "transform": [
     {
      "filter": "isValid(datum.tcp) && datum.tcp > 0"
     },
     {
      "aggregate": [
       {
        "op": "median",
        "field": "tcp",
        "as": "tcp"
       }
      ],
      "groupby": [
       "config",
       "target_key"
      ]
     },
     {
      "aggregate": [
       {
        "op": "median",
        "field": "tcp",
        "as": "tcp"
       },
       {
        "op": "count",
        "as": "n"
       }
      ],
      "groupby": [
       "config"
      ]
     },
     {
      "joinaggregate": [
       {
        "op": "min",
        "field": "tcp",
        "as": "best"
       }
      ]
     },
     {
      "calculate": "datum.tcp / datum.best",
      "as": "ratio"
     },
     {
      "window": [
       {
        "op": "rank",
        "as": "rank"
       }
      ],
      "sort": [
       {
        "field": "tcp",
        "order": "ascending"
       }
      ]
     },
     {
      "calculate": "'#' + (datum.rank < 10 ? '0' : '') + datum.rank + '  ' + datum.config + '   ' + format(datum.tcp, '.3~g') + ' mm   ×' + (datum.ratio < 100 ? format(datum.ratio, '.3~g') : format(datum.ratio, ',.0f')) + '   n=' + datum.n",
      "as": "label"
     }
    ],
    "mark": {
     "type": "point",
     "filled": true,
     "size": 120,
     "opacity": 1,
     "color": "#57606a"
    },
    "encoding": {
     "y": {
      "field": "label",
      "type": "nominal",
      "sort": {
       "field": "tcp"
      },
      "title": null,
      "axis": {
       "labelLimit": 460,
       "labelFontSize": 11,
       "labelOverlap": false
      }
     },
     "x": {
      "field": "tcp",
      "type": "quantitative",
      "scale": {
       "type": "log"
      },
      "title": "tool tracking RMS at 1.0 ×, mm (median over targets of median over its runs); n = targets"
     }
    }
   },
   "hover": {
    "title": "config",
    "fields": [
     "tcp",
     "target_key"
    ]
   }
  },
  {
