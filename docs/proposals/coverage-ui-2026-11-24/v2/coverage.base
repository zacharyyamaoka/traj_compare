# V2 "Rows first" (coverage-ui babble round 2026-11-24): the trajectories are rows, every focus area is a view of the
# rows the rail and the query bar leave. GENERATED by v2/tools/emit.mjs from data/coverage.json (the page builds the
# same document in js/base.js); edit base.js, never this file. The rows are js/rows.js over data/trajectories.json +
# data/membership.json. `occupancy` and `coverage-overview` are views V2 registers (js/views.js), not stock data-ui.
facets:
  - as: search
    properties:
      - name
      - split
      - kind
      - tags
    label: Find
    placeholder: Search trajectories (try holdout)
  - { property: split, label: Split }
  - { property: kind, label: Kind }
  - { property: tags, label: Tags }
  - { property: rung, label: Rung }
  - { property: duration_s, as: slider-histogram, label: Duration, unit: s }
  - { property: new_cells, as: slider-histogram, label: New cells }
  - { property: tool_z_min_mm, as: range, label: Tool z low, unit: mm }
  - { property: tool_z_max_mm, as: range, label: Tool z high, unit: mm }
properties:
  name: { displayName: Trajectory }
  order: { displayName: '#' }
  split: { displayName: Split, colors: { dev: 1, holdout: 7 } }
  kind: { displayName: Kind }
  rung: { displayName: Rung }
  tags: { displayName: Tags }
  duration_s: { displayName: Duration }
  samples: { displayName: Samples }
  new_cells:
    displayName: New cells
    description: "position × speed cells (all joints) it was the first to visit, in the dataset's order"
  only_it_cells:
    displayName: Only it
    description: 'position × speed cells (all joints) no other trajectory visits: drop it and they are gone'
  tool_path_m: { displayName: Tool path }
  tool_speed_max_m_s: { displayName: Tool speed max }
  tool_z_min_mm: { displayName: Tool z low }
  tool_z_max_mm: { displayName: Tool z high }
  tool_tilt_max_deg: { displayName: Tilt max, description: largest tilt of the tool axis from straight down }
  rrd: { displayName: Rerun file }
  cells_shoulder_pan_q_qd: { hidden: true }
  cells_shoulder_pan_qd_qdd: { hidden: true }
  cells_shoulder_pan_q_qdd: { hidden: true }
  cells_shoulder_lift_q_qd: { hidden: true }
  cells_shoulder_lift_qd_qdd: { hidden: true }
  cells_shoulder_lift_q_qdd: { hidden: true }
  cells_elbow_q_qd: { hidden: true }
  cells_elbow_qd_qdd: { hidden: true }
  cells_elbow_q_qdd: { hidden: true }
  cells_wrist_1_q_qd: { hidden: true }
  cells_wrist_1_qd_qdd: { hidden: true }
  cells_wrist_1_q_qdd: { hidden: true }
  cells_wrist_2_q_qd: { hidden: true }
  cells_wrist_2_qd_qdd: { hidden: true }
  cells_wrist_2_q_qdd: { hidden: true }
  cells_wrist_3_q_qd: { hidden: true }
  cells_wrist_3_qd_qdd: { hidden: true }
  cells_wrist_3_q_qdd: { hidden: true }
  cells_xy: { hidden: true }
  cells_xz: { hidden: true }
  cells_yz: { hidden: true }
  cells_voxels: { hidden: true }
  cells_directions: { hidden: true }
views:
  - type: coverage-overview
    name: Overview
    order: [name, split, kind, rung, tags]
    overview:
      numbers:
        - { label: Trajectories, summary: count, payload: trajectories }
        - { label: Samples, summary: sum, property: samples, payload: samples }
        - { label: Motion, summary: sum, property: duration_s, unit: s, decimals: 1, payload: duration_s }
        - label: Position × speed cells
          summary: distinct-mean
          properties:
            - cells_shoulder_pan_q_qd
            - cells_shoulder_lift_q_qd
            - cells_elbow_q_qd
            - cells_wrist_1_q_qd
            - cells_wrist_2_q_qd
            - cells_wrist_3_q_qd
          total: 864
          unit: '%'
          note: mean over joints
          payload: q_qd_visited_mean_pct
        - label: Speed × accel. cells
          summary: distinct-mean
          properties:
            - cells_shoulder_pan_qd_qdd
            - cells_shoulder_lift_qd_qdd
            - cells_elbow_qd_qdd
            - cells_wrist_1_qd_qdd
            - cells_wrist_2_qd_qdd
            - cells_wrist_3_qd_qdd
          total: 576
          unit: '%'
          note: mean over joints
          payload: qd_qdd_visited_mean_pct
        - label: 'Tool pixels, top view'
          summary: distinct
          property: cells_xy
          note: '2 cm'
          payload: tool_pixels_xy
        - label: Tool voxels
          summary: distinct
          property: cells_voxels
          note: '5 cm'
          payload: tool_voxels_visited
        - label: Reachable voxels reached
          summary: distinct
          property: cells_voxels
          total: 28289
          unit: '%'
          decimals: 1
          payload: tool_voxels_reachable_pct
        - label: Tool directions
          summary: distinct
          property: cells_directions
          total: 288
          unit: '%'
          note: equal-area cells
          payload: tool_directions_visited_pct
        - label: Largest tilt
          summary: max
          property: tool_tilt_max_deg
          unit: '°'
          decimals: 0
          payload: tool_tilt_max_deg
          tolerance: 0.01
      whole: [q_span_median_pct, qd_peak_max_pct, qdd_peak_max_pct, tool_speed_p99_m_s]
      minis: [All joints, Tool position, Tool orientation]
  - type: occupancy
    name: One joint
    order: [name, split, kind, rung, tags]
    occupancy:
      of: trajectory
      pick: { label: Joint }
      columns: 2
      panels:
        - group: shoulder_pan
          title: 'Which positions and speeds?'
          code: shoulder_pan q×qd
          cells: cells_shoulder_pan_q_qd
          shape: [36, 24]
          order: x-major
          xAxis: { label: q · position, unit: '°', lo: -360, hi: 360 }
          yAxis: { label: qd · speed, unit: '°/s', lo: -180, hi: 180 }
          frame: limit
          zero: 'y'
          payload: planes.shoulder_pan_joint.q_qd
        - group: shoulder_pan
          title: 'Which speeds and accelerations?'
          code: shoulder_pan qd×qdd
          cells: cells_shoulder_pan_qd_qdd
          shape: [24, 24]
          order: x-major
          xAxis: { label: qd · speed, unit: '°/s', lo: -180, hi: 180 }
          yAxis: { label: qdd · acceleration, unit: '°/s²', lo: -343.77, hi: 343.77 }
          frame: limit
          zero: both
          payload: planes.shoulder_pan_joint.qd_qdd
        - group: shoulder_pan
