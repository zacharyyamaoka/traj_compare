  - type: occupancy
    name: Tool orientation
    order: [name, split, kind, rung, tags]
    occupancy:
      of: trajectory
      columns: 1
      panels:
        - title: 'Which way does the tool point?'
          code: tool directions
          cells: cells_directions
          shape: [24, 12]
          order: y-major
          xAxis: { label: 'azimuth · which way it leans, in the x-y plane', unit: '°', lo: -180, hi: 180 }
          yAxis:
            label: tilt from straight down
            unit: '°'
            lo: 0
            hi: 180
            flip: true
            edges: [0, 33.6, 48.2, 60, 70.5, 80.4, 90, 99.6, 109.5, 120, 131.8, 146.4, 180]
          marginals: { x: per azimuth band, 'y': per tilt band }
          payload: tool.orientation.sphere
  - type: table
    name: Trajectories
    order: [name, split, kind, tags, duration_s, samples, new_cells, only_it_cells, tool_path_m, tool_speed_max_m_s, tool_z_min_mm, tool_z_max_mm, tool_tilt_max_deg]
    groupBy: { property: split, direction: ASC }
    display: { split: badge, new_cells: bar, only_it_cells: bar }
    summaries: { duration_s: Sum, samples: Sum }
    columnSize: { name: 200 }
    record: { sections: [{ name: Trajectory, properties: [kind, duration_s, new_cells, only_it_cells] }] }
  - type: table
    name: New ground
    order: [name, split, kind, new_cells, only_it_cells, duration_s, tool_path_m, tool_tilt_max_deg]
    sort:
      - { property: only_it_cells, direction: DESC }
    display: { split: badge, new_cells: bar, only_it_cells: bar }
    columnSize: { name: 200 }
    record: { sections: [{ name: Trajectory, properties: [kind, duration_s, new_cells, only_it_cells] }] }
