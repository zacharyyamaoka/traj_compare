            row: { field: signal, type: nominal, title: null, header: { labelAngle: 0, labelAlign: left, labelAnchor: start, labelOrient: top, labelPadding: 2 }, sort: [q · position (°), qd · speed (°/s), qdd · acceleration (°/s²), qddd · jerk (°/s³)] }
        - mark: { type: rect, color: "#cfcac2", opacity: 0.55, cornerRadius: 0, strokeWidth: 0 }
          encoding:
            x: { field: edge_low, aggregate: min, type: quantitative, title: null }
            x2: { field: limit_low, aggregate: min, title: null }
        - mark: { type: rect, color: "#cfcac2", opacity: 0.55, cornerRadius: 0, strokeWidth: 0 }
          encoding:
            x: { field: limit_high, aggregate: max, type: quantitative, title: null }
            x2: { field: edge_high, aggregate: max, title: null }
        - mark: { type: rule, color: "#c0392b", strokeWidth: 1.4 }
          encoding:
            x: { field: limit_low, aggregate: min, type: quantitative, title: null }
        - mark: { type: rule, color: "#c0392b", strokeWidth: 1.4 }
          encoding:
            x: { field: limit_high, aggregate: max, type: quantitative, title: null }
        - mark: { type: rule, color: "#18181b", strokeWidth: 1, strokeDash: [2, 2] }
          encoding:
            x: { field: p001, aggregate: min, type: quantitative, title: null }
        - mark: { type: rule, color: "#18181b", strokeWidth: 1, strokeDash: [2, 2] }
          encoding:
            x: { field: p999, aggregate: max, type: quantitative, title: null }
