  - type: sections
    name: One joint
    status: false
    colorBy: dataset
    pick: { label: Joint, options: [shoulder_pan, shoulder_lift, elbow, wrist_1, wrist_2, wrist_3] }
    figures:
      - key: planes
        title: '{pick} · position, speed and acceleration'
        note: "trajectories per cell; red frame = the joint's limits"
        kind: maps
        panels:
          - group: shoulder_pan
            title: Position × speed
            code: q×qd
            cells: cells_shoulder_pan_q_qd
            shape: [36, 24]
            order: x-major
            aspect: 0.62
            xAxis: { label: q · position, unit: '°', lo: -360, hi: 360 }
            yAxis: { label: qd · speed, unit: '°/s', lo: -180, hi: 180 }
            frame: limit
            zero: 'y'
            payload: planes.shoulder_pan_joint.q_qd
          - group: shoulder_pan
            title: Speed × acceleration
            code: qd×qdd
            cells: cells_shoulder_pan_qd_qdd
            shape: [24, 24]
            order: x-major
            aspect: 0.62
            xAxis: { label: qd · speed, unit: '°/s', lo: -180, hi: 180 }
            yAxis: { label: qdd · acceleration, unit: '°/s²', lo: -343.77, hi: 343.77 }
            frame: limit
            zero: both
            payload: planes.shoulder_pan_joint.qd_qdd
          - group: shoulder_pan
            title: Position × acceleration
            code: q×qdd
            cells: cells_shoulder_pan_q_qdd
            shape: [36, 24]
            order: x-major
            aspect: 0.62
            xAxis: { label: q · position, unit: '°', lo: -360, hi: 360 }
            yAxis: { label: qdd · acceleration, unit: '°/s²', lo: -343.77, hi: 343.77 }
            frame: limit
            zero: 'y'
            payload: planes.shoulder_pan_joint.q_qdd
          - group: shoulder_lift
            title: Position × speed
            code: q×qd
            cells: cells_shoulder_lift_q_qd
            shape: [36, 24]
            order: x-major
