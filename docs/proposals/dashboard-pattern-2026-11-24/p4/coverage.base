# P4 "Run selector, TensorBoard / W&B style" (dashboard-pattern babble round 2026-11-24). GENERATED by p4/tools/emit.mjs
# from data/*.json (the page builds the same document in js/base.js); edit base.js, never this file.
# `runs:` is the run list P4 proposes for data-ui (<data-runs for>); `sections` is the view type P4 registers.
runs:
  group: dataset
  label: Datasets
  title: task
  toggles:
    - { property: split, label: Split }
    - { property: kind, label: Kind }
  regex: [dataset, task]
properties:
  task: { displayName: Trajectory }
  dataset:
    displayName: Dataset
    colors:
      UR5e alone · Workspace: 1
      Cell · Workspace: 2
      Cell · Conveyor PnP: 3
      Cell · Conveyor Collision: 4
  dataset_order: { displayName: 'Dataset #', hidden: true }
  order: { displayName: '#', hidden: true }
  split: { displayName: Split, colors: { dev: 0, holdout: 7 } }
  kind: { displayName: Kind }
  tags: { displayName: Tags }
  duration_s: { displayName: Duration }
  samples: { displayName: Samples }
  new_cells:
    displayName: New cells
    description: "position × speed cells (all joints) it was the first to visit, in the 212's order"
  only_it_cells:
    displayName: Only it
    description: position × speed cells (all joints) no other of the 212 visits
  tool_path_m: { displayName: Tool path }
  tool_speed_max_m_s: { displayName: Tool speed max }
  tool_z_min_mm: { displayName: Tool z low }
  tool_z_max_mm: { displayName: Tool z high }
  tool_tilt_max_deg: { displayName: Tilt max, description: largest tilt of the tool axis from straight down }
  rrd: { displayName: Rerun file }
  cells_shoulder_pan_q_qd: { hidden: true }
  cells_shoulder_pan_qd_qdd: { hidden: true }
  cells_shoulder_pan_q_qdd: { hidden: true }
  cells_shoulder_lift_q_qd: { hidden: true }
  cells_shoulder_lift_qd_qdd: { hidden: true }
  cells_shoulder_lift_q_qdd: { hidden: true }
  cells_elbow_q_qd: { hidden: true }
  cells_elbow_qd_qdd: { hidden: true }
  cells_elbow_q_qdd: { hidden: true }
  cells_wrist_1_q_qd: { hidden: true }
  cells_wrist_1_qd_qdd: { hidden: true }
  cells_wrist_1_q_qdd: { hidden: true }
  cells_wrist_2_q_qd: { hidden: true }
  cells_wrist_2_qd_qdd: { hidden: true }
  cells_wrist_2_q_qdd: { hidden: true }
  cells_wrist_3_q_qd: { hidden: true }
  cells_wrist_3_qd_qdd: { hidden: true }
  cells_wrist_3_q_qdd: { hidden: true }
  cells_xy: { hidden: true }
  cells_xz: { hidden: true }
  cells_yz: { hidden: true }
  cells_voxels: { hidden: true }
  cells_directions: { hidden: true }
views:
  - type: sections
    name: Overview
    status: false
    colorBy: dataset
    figures:
      - key: numbers
        title: Headline numbers
        note: 'a row per dataset shown (a runs table), and all of them together'
        kind: numbers
        numbers:
          - { label: Trajectories, summary: count, payload: trajectories, decimals: 0 }
          - { label: Samples, summary: sum, property: samples, payload: samples, decimals: 0, wide: true }
          - { label: Motion, summary: sum, property: duration_s, unit: s, decimals: 0, payload: duration_s }
          - label: Position × speed cells
            summary: distinct-mean
            properties:
              - cells_shoulder_pan_q_qd
              - cells_shoulder_lift_q_qd
              - cells_elbow_q_qd
              - cells_wrist_1_q_qd
              - cells_wrist_2_q_qd
              - cells_wrist_3_q_qd
            total: 864
            unit: '%'
            decimals: 1
            note: mean over joints
            payload: q_qd_visited_mean_pct
          - label: Speed × accel. cells
            summary: distinct-mean
            properties:
              - cells_shoulder_pan_qd_qdd
              - cells_shoulder_lift_qd_qdd
              - cells_elbow_qd_qdd
              - cells_wrist_1_qd_qdd
              - cells_wrist_2_qd_qdd
              - cells_wrist_3_qd_qdd
            total: 576
            unit: '%'
            decimals: 1
            note: mean over joints
            payload: qd_qdd_visited_mean_pct
            wide: true
          - label: 'Tool pixels, top view'
            summary: distinct
            property: cells_xy
            note: '2 cm'
            decimals: 0
            payload: tool_pixels_xy
          - label: Tool voxels
            summary: distinct
            property: cells_voxels
            note: '5 cm'
            decimals: 0
            payload: tool_voxels_visited
            wide: true
          - label: Reachable voxels reached
            summary: distinct
            property: cells_voxels
            total: 66552
            unit: '%'
            decimals: 1
            payload: tool_voxels_reachable_pct
            wide: true
          - label: Tool directions
            summary: distinct
            property: cells_directions
            total: 288
            unit: '%'
            decimals: 1
            note: equal-area cells
            payload: tool_directions_visited_pct
          - label: Largest tilt
            summary: max
            property: tool_tilt_max_deg
            unit: '°'
            decimals: 0
            payload: tool_tilt_max_deg
            tolerance: 0.01
      - key: joints
        title: Every joint · which positions and speeds
        note: 'position × speed, trajectories per cell'
        kind: maps
        compact: true
        panels:
          - group: shoulder_pan
            title: shoulder_pan
            code: q×qd
            cells: cells_shoulder_pan_q_qd
            shape: [36, 24]
            order: x-major
            aspect: 0.62
            xAxis: { label: q · position, unit: '°', lo: -360, hi: 360 }
            yAxis: { label: qd · speed, unit: '°/s', lo: -180, hi: 180 }
            frame: limit
            zero: 'y'
            payload: planes.shoulder_pan_joint.q_qd
          - group: shoulder_lift
            title: shoulder_lift
            code: q×qd
            cells: cells_shoulder_lift_q_qd
            shape: [36, 24]
            order: x-major
            aspect: 0.62
            xAxis: { label: q · position, unit: '°', lo: -360, hi: 360 }
            yAxis: { label: qd · speed, unit: '°/s', lo: -180, hi: 180 }
            frame: limit
            zero: 'y'
            payload: planes.shoulder_lift_joint.q_qd
          - group: elbow
            title: elbow
            code: q×qd
            cells: cells_elbow_q_qd
            shape: [36, 24]
            order: x-major
            aspect: 0.62
            xAxis: { label: q · position, unit: '°', lo: -179.99, hi: 179.99 }
            yAxis: { label: qd · speed, unit: '°/s', lo: -180, hi: 180 }
            frame: limit
            zero: 'y'
            payload: planes.elbow_joint.q_qd
          - group: wrist_1
            title: wrist_1
            code: q×qd
            cells: cells_wrist_1_q_qd
            shape: [36, 24]
            order: x-major
            aspect: 0.62
            xAxis: { label: q · position, unit: '°', lo: -360, hi: 360 }
            yAxis: { label: qd · speed, unit: '°/s', lo: -180, hi: 180 }
            frame: limit
            zero: 'y'
            payload: planes.wrist_1_joint.q_qd
          - group: wrist_2
            title: wrist_2
            code: q×qd
            cells: cells_wrist_2_q_qd
            shape: [36, 24]
            order: x-major
            aspect: 0.62
            xAxis: { label: q · position, unit: '°', lo: -360, hi: 360 }
            yAxis: { label: qd · speed, unit: '°/s', lo: -180, hi: 180 }
            frame: limit
            zero: 'y'
            payload: planes.wrist_2_joint.q_qd
          - group: wrist_3
            title: wrist_3
            code: q×qd
            cells: cells_wrist_3_q_qd
            shape: [36, 24]
            order: x-major
            aspect: 0.62
            xAxis: { label: q · position, unit: '°', lo: -360, hi: 360 }
            yAxis: { label: qd · speed, unit: '°/s', lo: -180, hi: 180 }
            frame: limit
            zero: 'y'
            payload: planes.wrist_3_joint.q_qd
      - key: tool
        title: 'The tool · from three sides, and where it points'
