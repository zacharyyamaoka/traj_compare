  - type: sections
    name: Tool orientation
    status: false
    colorBy: dataset
    figures:
      - key: pointing
        title: 'Which way does the tool point?'
        note: 'equal-area map of the tool axis: azimuth × tilt from straight down'
        kind: maps
        panels:
          - title: Where it points
            code: 'azimuth, tilt'
            cells: cells_directions
            shape: [24, 12]
            order: y-major
            aspect: 0.5
            xAxis: { label: azimuth, unit: '°', lo: -180, hi: 180 }
            yAxis:
              label: tilt from down
              unit: '°'
              lo: 0
              hi: 180
              flip: true
              edges: [0, 33.6, 48.2, 60, 70.5, 80.4, 90, 99.6, 109.5, 120, 131.8, 146.4, 180]
            payload: tool.orientation.sphere
      - key: share
        title: 'Directions visited, per dataset'
        note: share of the 288 equal-area direction cells
        kind: bars
        unit: '%'
        items: [{ label: Directions visited, cells: cells_directions, total: 288, group: null }]
  - type: table
    name: Trajectories
    order: [task, dataset, split, kind, tags, duration_s, samples, new_cells, only_it_cells, tool_path_m, tool_speed_max_m_s, tool_tilt_max_deg]
    sort:
      - { property: dataset_order, direction: ASC }
      - { property: order, direction: ASC }
    display: { dataset: badge, split: badge, only_it_cells: bar }
    summaries: { duration_s: Sum, samples: Sum }
    columnSize: { task: 180, dataset: 190 }
    record:
      sections: [{ name: Trajectory, properties: [dataset, split, kind, duration_s, only_it_cells] }]
