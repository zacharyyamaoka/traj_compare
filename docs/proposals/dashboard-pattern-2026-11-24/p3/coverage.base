# P3 "Every tab is a saved view" (dashboard-pattern babble round 2026-11-24): one <data-views> over the 212
# trajectories, a <data-facets> rail beside it, and every dashboard a view entry of the proposed type `panels`.
# GENERATED by p3/tools/emit.mjs from data/coverage.json (the page builds the same document in js/base.js); edit
# base.js, never this file. Not data-ui yet: `settings:`, `subset:`, `type: panels` (panels, vars, use, repeat), the views
# P3 registers (occupancy, numbers, coverage-key).
subset: { noun: trajectory, by: [dataset, split] }
viewTypes: [panels, table, chart]
settings:
  cmap:
    type: dropdown
    displayName: Colour map
    options: { viridis: viridis, magma: magma, plasma: plasma, inferno: inferno, cividis: cividis }
    default: viridis
  reverse: { type: toggle, displayName: 'Reverse (high = dark)', default: false }
  scale:
    type: dropdown
    displayName: Scale
    options:
      linear: linear (clipped at p98)
      log: log
      equalized: histogram-equalized
      visited: visited / not
      enough: '≥ enough / not'
    default: linear
facets:
  - property: dataset
    label: Dataset
    order: [UR5e alone · Workspace, Cell · Workspace, Cell · Conveyor PnP, Cell · Conveyor Collision]
  - { property: split, label: Split, order: [dev, holdout] }
  - { property: kind, label: Kind }
  - as: search
    properties:
      - task
      - kind
      - tags
    label: Find
    placeholder: Trajectory name (try holdout-00)
  - { property: tags, label: Tags, collapsed: true }
  - { property: duration_s, as: slider-histogram, label: Duration, unit: s, collapsed: true }
  - { property: new_cells, as: slider-histogram, label: New cells, collapsed: true }
  - { property: tool_tilt_max_deg, as: slider-histogram, label: Tilt max, unit: '°', collapsed: true }
properties:
  task: { displayName: Trajectory }
  name: { displayName: Dataset / task }
  order: { displayName: '#' }
  dataset:
    displayName: Dataset
    colors:
      UR5e alone · Workspace: 1
      Cell · Workspace: 2
      Cell · Conveyor PnP: 3
      Cell · Conveyor Collision: 5
    description: Which of the four UR5e datasets the trajectory is from
  split: { displayName: Split, colors: { dev: 0, holdout: 7 } }
  kind: { displayName: Kind }
  tags: { displayName: Tags }
  belt_speed: { displayName: Belt speed }
  duration_s: { displayName: Duration }
  samples: { displayName: Samples }
  new_cells:
    displayName: New cells
    description: "position × speed cells (all joints) it was the first to visit, in the set's order"
  only_it_cells:
    displayName: Only it
    description: 'position × speed cells (all joints) no other of the 212 trajectories visits: drop it and they are gone'
  tool_path_m: { displayName: Tool path }
  tool_speed_max_m_s: { displayName: Tool speed max }
  tool_z_min_mm: { displayName: Tool z low }
  tool_z_max_mm: { displayName: Tool z high }
  tool_tilt_max_deg: { displayName: Tilt max, description: largest tilt of the tool axis from straight down }
  rrd: { displayName: Rerun file }
  cells_shoulder_pan_q_qd: { hidden: true }
  cells_shoulder_pan_qd_qdd: { hidden: true }
  cells_shoulder_pan_q_qdd: { hidden: true }
  cells_shoulder_lift_q_qd: { hidden: true }
  cells_shoulder_lift_qd_qdd: { hidden: true }
  cells_shoulder_lift_q_qdd: { hidden: true }
  cells_elbow_q_qd: { hidden: true }
  cells_elbow_qd_qdd: { hidden: true }
  cells_elbow_q_qdd: { hidden: true }
  cells_wrist_1_q_qd: { hidden: true }
  cells_wrist_1_qd_qdd: { hidden: true }
  cells_wrist_1_q_qdd: { hidden: true }
  cells_wrist_2_q_qd: { hidden: true }
  cells_wrist_2_qd_qdd: { hidden: true }
  cells_wrist_2_q_qdd: { hidden: true }
  cells_wrist_3_q_qd: { hidden: true }
  cells_wrist_3_qd_qdd: { hidden: true }
  cells_wrist_3_q_qdd: { hidden: true }
  cells_xy: { hidden: true }
  cells_xz: { hidden: true }
  cells_yz: { hidden: true }
  cells_voxels: { hidden: true }
  cells_directions: { hidden: true }
views:
  - type: panels
    name: Overview
    panels:
      - key: numbers
        title: Headline numbers
        w: 12
        view:
          type: numbers
          numbers:
            - { label: Trajectories, summary: count, payload: trajectories }
            - { label: Samples, summary: sum, property: samples, payload: samples }
            - label: Motion
              summary: sum
              property: duration_s
              unit: s
              decimals: 1
              payload: duration_s
            - label: Position × speed cells
              summary: distinct-mean
              properties:
                - cells_shoulder_pan_q_qd
                - cells_shoulder_lift_q_qd
                - cells_elbow_q_qd
                - cells_wrist_1_q_qd
                - cells_wrist_2_q_qd
                - cells_wrist_3_q_qd
              total: 864
              unit: '%'
              note: mean over joints
              payload: q_qd_visited_mean_pct
            - label: Speed × accel. cells
              summary: distinct-mean
              properties:
                - cells_shoulder_pan_qd_qdd
                - cells_shoulder_lift_qd_qdd
                - cells_elbow_qd_qdd
                - cells_wrist_1_qd_qdd
                - cells_wrist_2_qd_qdd
                - cells_wrist_3_qd_qdd
              total: 576
              unit: '%'
              note: mean over joints
              payload: qd_qdd_visited_mean_pct
            - label: 'Tool pixels, from above'
              summary: distinct
              property: cells_xy
              note: '2 cm'
              payload: tool_pixels_xy
            - label: Tool voxels
              summary: distinct
              property: cells_voxels
              note: '5 cm'
              payload: tool_voxels_visited
            - label: Reachable voxels reached
              summary: distinct
              property: cells_voxels
              total: 66552
              unit: '%'
              decimals: 1
              payload: tool_voxels_reachable_pct
            - label: Tool directions
              summary: distinct
              property: cells_directions
              total: 288
              unit: '%'
              note: equal-area cells
              payload: tool_directions_visited_pct
            - label: Largest tilt
              summary: max
              property: tool_tilt_max_deg
              unit: '°'
              decimals: 0
              payload: tool_tilt_max_deg
              tolerance: 0.01
          whole: [q_span_median_pct, qd_peak_max_pct, qdd_peak_max_pct, tool_speed_p99_m_s]
      - key: joints
        title: Every joint · positions × speeds
        open: One joint
        w: 4
        view:
          type: occupancy
          occupancy:
            of: trajectory
            columns: 3
            panels:
              - group: shoulder_pan
                title: shoulder_pan
                code: shoulder_pan q×qd
                cells: cells_shoulder_pan_q_qd
                shape: [36, 24]
                order: x-major
                xAxis: { label: q · position, unit: '°', lo: -360, hi: 360 }
                yAxis: { label: qd · speed, unit: '°/s', lo: -180, hi: 180 }
                frame: limit
                zero: 'y'
                payload: planes.shoulder_pan_joint.q_qd
                marginals: { x: position }
              - group: shoulder_lift
                title: shoulder_lift
                code: shoulder_lift q×qd
                cells: cells_shoulder_lift_q_qd
                shape: [36, 24]
                order: x-major
                xAxis: { label: q · position, unit: '°', lo: -360, hi: 360 }
                yAxis: { label: qd · speed, unit: '°/s', lo: -180, hi: 180 }
                frame: limit
                zero: 'y'
                payload: planes.shoulder_lift_joint.q_qd
                marginals: { x: position }
              - group: elbow
                title: elbow
                code: elbow q×qd
                cells: cells_elbow_q_qd
                shape: [36, 24]
                order: x-major
                xAxis: { label: q · position, unit: '°', lo: -179.99, hi: 179.99 }
                yAxis: { label: qd · speed, unit: '°/s', lo: -180, hi: 180 }
                frame: limit
                zero: 'y'
                payload: planes.elbow_joint.q_qd
                marginals: { x: position }
              - group: wrist_1
                title: wrist_1
                code: wrist_1 q×qd
                cells: cells_wrist_1_q_qd
                shape: [36, 24]
                order: x-major
                xAxis: { label: q · position, unit: '°', lo: -360, hi: 360 }
                yAxis: { label: qd · speed, unit: '°/s', lo: -180, hi: 180 }
                frame: limit
                zero: 'y'
                payload: planes.wrist_1_joint.q_qd
                marginals: { x: position }
              - group: wrist_2
                title: wrist_2
                code: wrist_2 q×qd
                cells: cells_wrist_2_q_qd
                shape: [36, 24]
                order: x-major
                xAxis: { label: q · position, unit: '°', lo: -360, hi: 360 }
                yAxis: { label: qd · speed, unit: '°/s', lo: -180, hi: 180 }
                frame: limit
                zero: 'y'
                payload: planes.wrist_2_joint.q_qd
                marginals: { x: position }
              - group: wrist_3
                title: wrist_3
                code: wrist_3 q×qd
                cells: cells_wrist_3_q_qd
                shape: [36, 24]
                order: x-major
                xAxis: { label: q · position, unit: '°', lo: -360, hi: 360 }
                yAxis: { label: qd · speed, unit: '°/s', lo: -180, hi: 180 }
                frame: limit
                zero: 'y'
                payload: planes.wrist_3_joint.q_qd
                marginals: { x: position }
          compact: true
      - key: tool
        title: The tool from three sides
        open: Tool position
        w: 5
        use: Tool position/tool
        compact: true
      - key: pointing
        title: Pointing
        open: Tool orientation
        w: 3
        use: Tool orientation/pointing
        compact: true
      - { key: key, w: 12, view: { type: coverage-key, items: [ramp, empty, outside, frame] } }
  - type: panels
    name: One joint
    vars:
      - key: joint
        label: Joint
        values: [shoulder_pan, shoulder_lift, elbow, wrist_1, wrist_2, wrist_3]
        value: shoulder_pan
    panels:
