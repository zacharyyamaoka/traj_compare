      - key: numbers
        title: The tool in numbers
        w: 3
        view:
          type: numbers
          columns: 1
          numbers:
            - { label: 'Tool pixels, from above', summary: distinct, property: cells_xy, note: '2 cm' }
            - { label: 'Tool pixels, from the front', summary: distinct, property: cells_xz, note: '2 cm' }
            - { label: Tool voxels, summary: distinct, property: cells_voxels, note: '5 cm' }
            - label: Reachable voxels reached
              summary: distinct
              property: cells_voxels
              total: 66552
              unit: '%'
              decimals: 1
            - label: 'Tool path, all trajectories'
              summary: sum
              property: tool_path_m
              unit: m
              decimals: 0
            - { label: Highest tool point, summary: max, property: tool_z_max_mm, unit: mm, decimals: 0 }
          caveat: "Each deployment's tool is in its own cell frame: the alone UR5e and the cell UR5e overlay as numbers, not as one room."
  - type: panels
    name: Tool orientation
    panels:
      - key: pointing
        title: 'Every direction the tool points, equal-area'
        w: 8
        view:
          type: occupancy
          occupancy:
            of: trajectory
            columns: 1
            panels:
              - title: 'Which way does the tool point?'
                code: tool directions
                cells: cells_directions
                shape: [24, 12]
                order: y-major
                xAxis:
                  label: 'azimuth · which way it leans, in the x-y plane'
                  unit: '°'
                  lo: -180
                  hi: 180
                yAxis:
                  label: tilt from straight down
                  unit: '°'
                  lo: 0
                  hi: 180
                  flip: true
                  edges: [0, 33.6, 48.2, 60, 70.5, 80.4, 90, 99.6, 109.5, 120, 131.8, 146.4, 180]
                marginals: { x: per azimuth band, 'y': per tilt band }
                payload: tool.orientation.sphere
          height: 460
      - key: numbers
        title: Pointing in numbers
        w: 4
        view:
          type: numbers
          columns: 1
          numbers:
            - label: Tool directions
              summary: distinct
              property: cells_directions
              total: 288
              unit: '%'
              note: equal-area cells
            - label: Directions visited
              summary: distinct
              property: cells_directions
              note: of 288 cells
            - { label: Largest tilt, summary: max, property: tool_tilt_max_deg, unit: '°', decimals: 0 }
            - label: 'Median trajectory’s largest tilt'
              summary: median
              property: tool_tilt_max_deg
              unit: '°'
              decimals: 0
  - type: table
    name: Trajectories
    order: [task, dataset, split, kind, duration_s, new_cells, only_it_cells, tool_path_m, tool_speed_max_m_s, tool_tilt_max_deg, samples, tags]
    display: { dataset: badge, split: badge, new_cells: bar, only_it_cells: bar }
    columnSize: { task: 170, dataset: 178 }
    record:
      sections:
        - { name: Trajectory, properties: [dataset, split, kind, duration_s, new_cells, only_it_cells] }
  - type: panels
    name: By dataset
    panels:
      - key: each
        repeat: dataset
        w: 12
        view:
          type: panels
          panels:
            - key: numbers
              w: 3
              view:
                type: numbers
                columns: 1
                compact: true
                numbers:
                  - { label: Trajectories, summary: count }
                  - label: Position × speed cells
                    summary: distinct-mean
                    properties:
                      - cells_shoulder_pan_q_qd
                      - cells_shoulder_lift_q_qd
                      - cells_elbow_q_qd
                      - cells_wrist_1_q_qd
                      - cells_wrist_2_q_qd
                      - cells_wrist_3_q_qd
                    total: 864
                    unit: '%'
                    note: mean over joints
                  - label: Tool directions
                    summary: distinct
                    property: cells_directions
                    total: 288
                    unit: '%'
            - key: joints
              title: Every joint · positions × speeds
              w: 5
              use: Overview/joints
              compact: true
            - key: tool
              title: From above
              w: 2
              view:
                type: occupancy
                compact: true
                occupancy:
                  of: trajectory
                  columns: 1
                  equal: true
                  frame: cell
                  panels:
                    - title: 'From above (x, y)'
                      code: tool xy
