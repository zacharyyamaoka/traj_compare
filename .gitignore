# WHY: bam_ws's root .gitignore covered these while traj_compare lived there (moved out 2026-11-20).
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
**/out/
# raw screenshots and GIFs of the 2026-07-29 viewer rounds: evidence, not source (kept on disk, out of history)
docs/viewer_*/
# review reports with inlined media (captures, video) stay out of git; text-only pages in reports/ are committed
reports/media/

# babble prototypes: the data extract is real bench data, regenerated by each round's extract.py
docs/proposals/*/data/

# scratch payloads and builds (coverage lanes, 2026-11-23): regenerated, never source
.cache/

# coverage UI round 2 (2026-11-24): the vendored data-ui build (re-made by `data-ui.mjs vendor main --into vendor/data-ui`) and the walkthrough captures
docs/proposals/*/vendor/
docs/proposals/*/shots/
docs/proposals/*/v*/rows/
docs/proposals/dashboard-pattern-2026-11-24/p1/rows.json
docs/proposals/rerun-joint-trajectory-2026-11-24/r*/**/*.rrd
docs/proposals/rerun-joint-trajectory-2026-11-24/r*/*.rrd
# every round's Rerun recordings (2026-11-25): rebuilt by each variant's make.py, never source
docs/proposals/*/**/*.rrd

# the grasp dataset viewer deploy (deploy/grasp-viewer): wrangler and its local state, never source
deploy/grasp-viewer/node_modules/
deploy/grasp-viewer/.wrangler/
